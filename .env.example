# Copie para .env e ajuste no servidor/hospital
# cp .env.example .env

POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8088
ML_PORT=8090

ASPNETCORE_ENVIRONMENT=Docker
SECURITY_REQUIRE_AUTH=true
JWT_SIGNING_KEY=troque-esta-chave-em-producao-com-32chars-min

# URL que o browser usa para falar com a API (host onde o Docker expõe a porta)
PUBLIC_API_URL=http://localhost:8080

AI_PROVIDER=Mock

# --- Salux real (read-only) ---
SALUX_ENABLED=false
SALUX_PROVIDER=SqlServer
# Exemplo SqlServer no host da máquina Docker:
# SALUX_CONNECTION_STRING=Server=host.docker.internal,1433;Database=Salux;User Id=hi_readonly;Password=***;TrustServerCertificate=True
# Exemplo SqlServer na rede do hospital:
# SALUX_CONNECTION_STRING=Server=10.0.0.50,1433;Database=Salux;User Id=hi_readonly;Password=***;TrustServerCertificate=True
SALUX_CONNECTION_STRING=
SALUX_POLL_INTERVAL_SECONDS=60
SALUX_BATCH_SIZE=200
# Query montada no volume deploy/salux-patient-query.sql
SALUX_PATIENT_QUERY_FILE=/app/config/salux-patient-query.sql
