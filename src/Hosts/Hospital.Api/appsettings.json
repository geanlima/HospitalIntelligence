{
  "ConnectionStrings": {
    "PatientsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "AdmissionsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "ExamsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "PrescriptionsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "VitalSignsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "ClinicalNotesDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "AlertsDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "TimelineDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "AiDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres",
    "SecurityDatabase": "Host=localhost;Port=5432;Database=hospital_intelligence;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HospitalCapacity": {
    "TotalBeds": 100
  },
  "Security": {
    "RequireAuth": true,
    "JwtIssuer": "HospitalIntelligence",
    "JwtAudience": "HospitalIntelligence",
    "JwtSigningKey": "dev-only-change-me-hospital-intelligence-32chars!",
    "TokenLifetimeMinutes": 480
  },
  "Salux": {
    "Enabled": false,
    "Provider": "SqlServer",
    "ConnectionString": "",
    "PollIntervalSeconds": 60,
    "BatchSize": 200,
    "PatientQuery": "SELECT TOP (@BatchSize) CAST(COD_PACIENTE AS varchar(50)) AS PatientCode, NOM_PACIENTE AS PatientName, CAST(DAT_NASCIMENTO AS date) AS BirthDate, CASE WHEN SEXO IN ('M', '1', 'Masculino') THEN 1 WHEN SEXO IN ('F', '2', 'Feminino') THEN 2 ELSE 0 END AS GenderCode, CAST(DAT_ALTERACAO AS datetimeoffset) AS UpdatedAtUtc FROM dbo.VW_HI_PACIENTES WHERE DAT_ALTERACAO > @Checkpoint ORDER BY DAT_ALTERACAO;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AI": {
    "Provider": "Mock",
    "VectorStore": "PgVector",
    "DefaultTopK": 3,
    "OpenAICompatible": {
      "BaseUrl": "http://localhost:11434/v1",
      "ApiKey": "",
      "Model": "llama3.2",
      "TimeoutSeconds": 60
    }
  },
  "AllowedHosts": "*"
}